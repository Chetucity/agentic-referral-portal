# Local development uses a file-backed SQLite database.
# In production point this at Turso: libsql://<db>-<org>.turso.io
DATABASE_URL="file:./data/app.db"
# DATABASE_AUTH_TOKEN=            # Turso only

SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Public origin, used for absolute URLs in the web manifest and metadata.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Set these only once Bubblewrap has generated a signing key — see PLAYSTORE.md.
# ANDROID_PACKAGE_NAME=com.koshcloud.referin
# ANDROID_SHA256_FINGERPRINTS=
