{
  "name": "referral-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "npm run db:push && npm run db:seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "rm -rf data && mkdir -p data && npm run setup",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/generate-icons.mjs",
    "playstore:check": "node scripts/playstore-smoke.mjs",
    "prebuild": "node scripts/copy-pdf-worker.mjs",
    "postinstall": "node scripts/copy-pdf-worker.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.44.7",
    "html2canvas": "^1.4.1",
    "jose": "^6.1.0",
    "jspdf": "^4.2.1",
    "mammoth": "^1.12.3",
    "next": "15.1.6",
    "pdfjs-dist": "^3.11.174",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.6",
    "playwright": "^1.62.1",
    "postcss": "^8.5.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
